---
import { site, url } from '../data/site';
const contacts = [
  { label: 'Телефон', text: site.phoneDisplay, href: 'tel:' + site.phone, icon: 'phone' },
  { label: 'Telegram', text: 'Написать в Telegram', href: site.telegram, icon: 'telegram' },
  { label: 'MAX', text: 'Написать в MAX', href: site.max, icon: 'max' },
  { label: 'E-mail', text: site.email, href: 'mailto:' + site.email, icon: 'mail' },
];
---

<footer class="footer">
  <div class="container">
    <section class="footer-contact-panel" aria-labelledby="footer-contact-name">
      <div class="footer-intro">
        <h2 id="footer-contact-name">{site.name}</h2>
        <p class="footer-expertise">Эксперт по сертификации продукции</p>
        <p class="footer-invitation">
          Если вам нужно понять, какие документы требуются для товара, напишите удобным способом —
          помогу сориентироваться.
        </p>
      </div>
      <div class="footer-contact-grid">
        {contacts.map((contact) => (
          <a class="footer-contact-card" href={contact.href}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              {contact.icon === 'phone' && (
                <path d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a15 15 0 0 1-6-6l2-2-2-5Z" />
              )}
              {contact.icon === 'telegram' && (
                <>
                  <path d="m3 10 18-7-4 18-6-6-4 3v-6l-4-2Z" />
                  <path d="m7 12 10-6-6 9" />
                </>
              )}
              {contact.icon === 'max' && (
                <>
                  <path d="M4 18 3 22l5-2a9 9 0 1 0-4-2Z" />
                  <path d="M7 15V8l5 5 5-5v7" />
                </>
              )}
              {contact.icon === 'mail' && (
                <>
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </>
              )}
            </svg>
            <span class="footer-contact-copy">
              <span class="footer-contact-label">{contact.label}</span>
              <span class="footer-contact-value">{contact.text}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
    <p class="legal-note">
      Консультации и экспертное сопровождение. Эксперт не является аккредитованным органом по
      сертификации или испытательной лабораторией, не выдает сертификаты соответствия и не проводит
      лабораторные испытания.
    </p>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {site.name || site.brand}
      </span>
      <a href={url('/privacy/')}>Политика обработки персональных данных</a>
      <a href={url('/personal-data-consent/')}>Согласие на обработку персональных данных</a>
    </div>
  </div>
</footer>

<style>
  .footer-contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2.75rem);
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .footer-intro h2 {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 0.65rem;
  }
  .footer-expertise {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0 0 1.25rem;
  }
  .footer-invitation {
    margin: 0;
    max-width: 42ch;
  }
  .footer-contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
  }
  .footer-contact-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 6.25rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .footer-contact-card:hover {
    border-color: var(--color-text);
    background: var(--color-bg);
  }
  .footer-contact-card:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }
  .footer-contact-card svg {
    flex: 0 0 1.5rem;
    width: 1.5rem;
    height: 1.5rem;
  }
  .footer-contact-copy {
    min-width: 0;
  }
  .footer-contact-label {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-small);
    margin-bottom: 0.25rem;
  }
  .footer-contact-value {
    display: block;
    overflow-wrap: anywhere;
  }
  @media (max-width: 1100px) {
    .footer-contact-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .footer-contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
