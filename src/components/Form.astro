---
import { site, url } from '../data/site';
const endpoint = import.meta.env.PUBLIC_CONTACT_API_URL || '';
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const enabled =
  import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true' &&
  /^https:\/\//.test(endpoint) &&
  !!sitekey &&
  site.legal.ready &&
  !!site.legal.operator &&
  !!site.email;
---

<section class="request" id="request">
  <div>
    <p class="eyebrow">Начнём с вашего товара</p>
    <h2>
      Что планируете
      <br />
      продавать?
    </h2>
    <p class="lead">
      Расскажите о товаре и задаче. Ссылка, описание или вопрос — хороший первый шаг.
    </p>
    <p class="form-notice">
      {!enabled && 'Онлайн-отправка заявки пока недоступна. Форма не передает данные.'}
      {site.email && (
        <>
          {' '}
          Напишите на <a href={`mailto:${site.email}`}>{site.email}</a>.
        </>
      )}
      {site.telegram && (
        <>
          {' '}
          Или свяжитесь в <a href={site.telegram}>Telegram</a>.
        </>
      )}
      {site.max && (
        <>
          {' '}
          Также можно написать в <a href={site.max}>MAX</a>.
        </>
      )}
      {site.phone && (
        <>
          {' '}
          Телефон: <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </>
      )}
    </p>
    <p class="inline-note">
      Проверка товара — 1 500 ₽.
      <br />
      Стоимость засчитывается в дальнейшее сопровождение.
    </p>
  </div>
  <form
    data-lead-form
    data-endpoint={enabled ? endpoint : ''}
    data-sitekey={enabled ? sitekey : ''}
    aria-label="Заявка на консультацию"
  >
    <div class="form-grid">
      <label class="field">
        Имя *
        <input
          name="name"
          autocomplete="name"
          required
          maxlength="100"
          placeholder="Как к вам обращаться"
        />
      </label>
      <label class="field">
        Телефон или Telegram *
        <input
          name="contact"
          autocomplete="tel"
          required
          minlength="3"
          maxlength="100"
          placeholder="+7 или @username"
        />
      </label>
      <label class="field">
        E-mail *
        <input
          type="email"
          name="email"
          autocomplete="email"
          required
          maxlength="254"
          placeholder="you@example.ru"
        />
      </label>
      <label class="field">
        Название товара *
        <input name="productName" required maxlength="200" placeholder="Что планируете продавать" />
      </label>
      <label class="field wide">
        Ссылка на товар <span class="form-hint">Необязательно</span>
        <input type="url" name="productUrl" maxlength="1000" placeholder="https://" />
      </label>
      <label class="field wide">
        Что требуется / комментарий
        <textarea
          name="message"
          rows="3"
          maxlength="1500"
          placeholder="Какая задача стоит перед вами?"
        ></textarea>
      </label>
    </div>
    <div hidden aria-hidden="true">
      <input
        name="website"
        tabindex="-1"
        autocomplete="off"
        maxlength="200"
        aria-label="Оставьте пустым"
      />
    </div>
    <div data-turnstile></div>
    <label class="consent">
      <input type="checkbox" name="consent" required value="accepted" />
      <span>
        Я даю <a href={url('/personal-data-consent/')}>согласие на обработку персональных данных</a>{' '}
        и ознакомлен(а) с{' '}
        <a href={url('/privacy-policy/')}>Политикой обработки персональных данных</a>.
      </span>
    </label>
    <div class="form-footer">
      <button class="button" type="submit" disabled>
        {enabled ? 'Отправить заявку' : 'Отправка пока недоступна'}{' '}
        <span aria-hidden="true">↗</span>
      </button>
      <p class="form-hint">* Обязательные поля. Не отправляйте паспортные и платежные данные.</p>
    </div>
    <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    <noscript>
      <p class="form-notice">
        Для отправки формы требуется JavaScript. Используйте опубликованные контакты для прямого
        обращения.
      </p>
    </noscript>
  </form>
</section>
<script>
  import { initContactForm } from '../scripts/contact-form';
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(initContactForm);
</script>
