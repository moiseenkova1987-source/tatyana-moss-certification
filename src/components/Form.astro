---
import { site, url } from '../data/site';
const endpoint = import.meta.env.PUBLIC_CONTACT_API_URL || '';
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const enabled =
  import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true' &&
  /^https:\/\//.test(endpoint) &&
  !!sitekey &&
  site.legal.ready &&
  !!site.legal.operator &&
  !!site.email;
---

<section class="request" id="request">
  <div>
    <p class="eyebrow">Начнём с вашего товара</p>
    <h2>Предварительный вопрос по вашему товару</h2>
    <p class="lead">
      Опишите товар и задачу — я посмотрю, с чего лучше начать и какие документы могут
      потребоваться.
    </p>
    <p class="form-notice">
      {!enabled &&
        'Онлайн-отправка пока недоступна. Форма не передает данные. Можно связаться напрямую.'}
      {site.email && (
        <>
          {' '}
          Напишите на <a href={`mailto:${site.email}`}>{site.email}</a>.
        </>
      )}
      {site.telegram && (
        <>
          {' '}
          Или свяжитесь в <a href={site.telegram}>Telegram</a>.
        </>
      )}
      {site.max && (
        <>
          {' '}
          Также можно написать в <a href={site.max}>MAX</a>.
        </>
      )}
      {site.phone && (
        <>
          {' '}
          Телефон: <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </>
      )}
    </p>
    <p class="inline-note">
      Отправка формы предназначена для предварительного обращения. Она не является заказом услуги и
      не означает заключение договора. Оплата через сайт не производится.
    </p>
  </div>
  <form
    data-lead-form
    data-endpoint={enabled ? endpoint : ''}
    data-sitekey={enabled ? sitekey : ''}
    aria-label="Предварительный вопрос по вашему товару"
  >
    <div class="form-grid">
      <label class="field">
        Имя *
        <input
          name="name"
          autocomplete="name"
          required
          maxlength="100"
          placeholder="Как к вам обращаться"
        />
      </label>
      <label class="field">
        Телефон или Telegram *
        <input
          name="contact"
          autocomplete="tel"
          required
          minlength="3"
          maxlength="100"
          placeholder="+7 или @username"
        />
      </label>
      <label class="field wide">
        Товар / категория *
        <input name="productName" required maxlength="200" placeholder="Что планируете продавать" />
      </label>
      <label class="field wide">
        Ваш вопрос *
        <textarea
          name="message"
          rows="3"
          required
          maxlength="1500"
          placeholder="Какая задача стоит перед вами?"
        ></textarea>
      </label>
    </div>
    <div hidden aria-hidden="true">
      <input
        name="website"
        tabindex="-1"
        autocomplete="off"
        maxlength="200"
        aria-label="Оставьте пустым"
      />
    </div>
    <div data-turnstile></div>
    <label class="consent">
      <input type="checkbox" name="consent" required value="accepted" />
      <span>
        Я даю <a href={url('/consent/')}>согласие на обработку моих персональных данных</a>
      </span>
    </label>
    <p class="form-hint">
      <a href={url('/privacy/')}>Политика обработки персональных данных</a>
    </p>
    <div class="form-footer">
      <button class="button" type="submit" disabled>
        Отправить вопрос <span aria-hidden="true">↗</span>
      </button>
      <p class="form-hint">* Обязательные поля. Не отправляйте паспортные и платежные данные.</p>
    </div>
    <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    <noscript>
      <p class="form-notice">
        Для отправки формы требуется JavaScript. Используйте опубликованные контакты для прямого
        обращения.
      </p>
    </noscript>
  </form>
</section>
<script>
  import { initContactForm } from '../scripts/contact-form';
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(initContactForm);
</script>
