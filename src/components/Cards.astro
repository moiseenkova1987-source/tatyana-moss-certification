---
import type { Service } from '../data/services';
import ServiceCard from './ServiceCard.astro';
const { items, calculate = false } = Astro.props as { items: Service[]; calculate?: boolean };
---

<div class="cards">
  {items.map((service, index) => (
    <ServiceCard service={service} index={index} calculate={calculate} />
  ))}
</div>
