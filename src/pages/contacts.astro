---
import Layout from '../layouts/Layout.astro';
import Form from '../components/Form.astro';
import { site } from '../data/site';
const telegramLabel = site.telegram.split('/').filter(Boolean).pop();
const formEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
---

<Layout
  title="Контакты Татьяны Моисеенковой — консультация по сертификации"
  description="Задайте Татьяне Моисеенковой предварительный вопрос о товаре и требованиях к продукции. Контакты для обращения: Telegram, MAX, телефон и e-mail."
  crumbs={[{ name: 'Контакты', path: '/contacts/' }]}
>
  <section class="page-hero">
    <p class="eyebrow">На связи</p>
    <h1>
      Давайте разберём
      <br />
      вашу задачу
    </h1>
    <p class="lead">
      Татьяна Моисеенкова, эксперт по сертификации продукции. Пришлите описание товара и расскажите,
      на каком этапе вам нужна помощь.
    </p>
    <div class="contact-options">
      {site.phone && <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>}
      {site.telegram && (
        <a href={site.telegram} target="_blank" rel="noopener noreferrer">
          Telegram @{telegramLabel} ↗
        </a>
      )}
      {site.max && (
        <a href={site.max} target="_blank" rel="noopener noreferrer">
          MAX ↗
        </a>
      )}
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </div>
  </section>
  {formEnabled ? (
    <Form />
  ) : (
    <section class="request" id="request" aria-labelledby="direct-contact-title">
      <div>
        <h2 id="direct-contact-title">Задать вопрос</h2>
        <p class="lead">
          Пока форма обратной связи временно недоступна, напишите мне напрямую удобным способом.
          Опишите товар и задачу — я посмотрю, с чего лучше начать и какие документы могут
          потребоваться.
        </p>
        <p class="form-hint">
          Чтобы я быстрее сориентировалась, укажите название товара, страну производства/ввоза и что
          именно нужно определить или оформить.
        </p>
      </div>
      <div class="direct-contact-actions">
        <a class="button" href={site.telegram} target="_blank" rel="noopener noreferrer">
          Написать в Telegram
        </a>
        <a class="button secondary" href={site.max} target="_blank" rel="noopener noreferrer">
          Написать в MAX
        </a>
        <a class="button secondary" href={`mailto:${site.email}`}>
          Написать на e-mail
        </a>
        <a class="button secondary" href={`tel:${site.phone}`}>
          <span>
            Позвонить
            <br />
            {site.phoneDisplay}
          </span>
        </a>
      </div>
    </section>
  )}
</Layout>

<style>
  .direct-contact-actions {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
</style>
