---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/site';
---

<Layout
  noindex
  redirectTo="/privacy/"
  title="Политика обработки данных: новый адрес — Татьяна Моисеенкова"
  description="Политика обработки данных: новый адрес. Перейдите к актуальному документу для предварительного обращения на сайте Татьяны Моисеенковой."
  crumbs={[{ name: 'Документ', path: '/privacy-policy/' }]}
>
  <section class="page-hero compact">
    <h1>Политика обработки данных: новый адрес</h1>
  </section>
  <article class="prose">
    <p>Документ размещён по новому адресу.</p>
    <p>
      <a href={url('/privacy/')}>Политика обработки персональных данных</a>
    </p>
  </article>
</Layout>
