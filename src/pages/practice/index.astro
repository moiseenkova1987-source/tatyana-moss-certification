---
import Layout from '../../layouts/Layout.astro';
import { practiceArticles, practiceDate } from '../../data/practice';
import { url } from '../../data/site';
---

<Layout
  title="Разборы и практика по сертификации — Татьяна Моисеенкова"
  description="Практические разборы по сертификации, декларациям, импорту и документам на товар: что проверить перед закупкой, ввозом или продажей продукции."
  crumbs={[{ name: 'Разборы и практика', path: '/practice/' }]}
>
  <section class="page-hero">
    <p class="eyebrow">Из экспертной практики</p>
    <h1>Разборы и практика по сертификации и техническому регулированию</h1>
    <p class="lead">
      Практические разборы по сертификации, декларациям, отказным письмам, импорту, маркировке и
      документам на товар. Без общих слов — только то, что действительно важно проверить перед
      закупкой, ввозом или продажей продукции.
    </p>
  </section>
  <section class="practice-cards" aria-label="Материалы">
    {practiceArticles.map((article) => (
      <article class="practice-card">
        <time datetime={article.datePublished}>{practiceDate(article.datePublished)}</time>
        <h2>
          <a href={url(`/practice/${article.slug}/`)}>{article.title}</a>
        </h2>
        <p>{article.description}</p>
        <a class="text-link" href={url(`/practice/${article.slug}/`)}>
          Читать разбор ↗
        </a>
      </article>
    ))}
  </section>
</Layout>
<style>
  .practice-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4);
    padding-bottom: var(--section-space);
  }
  .practice-card {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-soft);
    max-width: 48rem;
  }
  .practice-card h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    margin-top: var(--space-3);
  }
  .practice-card h2 a {
    color: inherit;
    text-decoration: none;
  }
  time {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
